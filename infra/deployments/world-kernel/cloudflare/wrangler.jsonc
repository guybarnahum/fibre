{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "fibre-world-kernel",
  "main": "./encounter-worker.mjs",
  "compatibility_date": "2026-08-31",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.yaml"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "FIBRE_DEPLOYMENT_ENV": "cloudflare",
    "FIBRE_WORLD_RECONCILIATION_MS": "5000"
  },
  "secrets": {
    "required": [
      "FIBRE_PRIVATE_TOKEN",
      "OPENAI_API_KEY"
    ]
  },
  "d1_databases": [
    {
      "binding": "ACTIVITY_LOG",
      "database_name": "fibre-activity-log"
    },
    {
      "binding": "PRESENTATION_CATALOG",
      "database_name": "fibre-presentation-catalog"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WORLD_STATE",
        "class_name": "FibreWorldDurableObject"
      },
      {
        "name": "ADMIN_LIVE",
        "class_name": "FibreAdminLiveDurableObject",
        "script_name": "fibre-thread-presentation"
      }
    ]
  },
  "services": [
    {
      "binding": "THREAD_PRESENTATION",
      "service": "fibre-thread-presentation"
    },
    {
      "binding": "ASSET_GENERATOR",
      "service": "fibre-asset-generator"
    }
  ],
  "exports": {
    "FibreWorldDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "THREAD_OBJECTS",
      "bucket_name": "fibre-thread-objects"
    }
  ]
}
