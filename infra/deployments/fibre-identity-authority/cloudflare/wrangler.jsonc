{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "fibre-identity-authority",
  "main": "./worker.mjs",
  "compatibility_date": "2026-09-01",
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.yaml"
      ],
      "fallthrough": true
    },
    {
      "type": "Data",
      "globs": [
        "**/assets/fid-card/v0.3-ocean/*.png",
        "**/assets/fid-card/v0.3-ocean/*.ttf"
      ],
      "fallthrough": true
    }
  ],
  "vars": {
    "FIBRE_DEPLOYMENT_ENV": "cloudflare",
    "FIA_ISSUER_KEY_ID": "fibre-fia-production-v1",
    "FIA_ISSUER_TRUST_POLICY": "fibre_fid_issuer_v1",
    "FIA_CREDENTIAL_KEY_ID": "fibre-fid-private-v1",
    "FIA_CREDENTIAL_POLICY_ID": "fid_private_v1"
  },
  "secrets": {
    "required": [
      "FIBRE_PRIVATE_TOKEN",
      "FIA_ISSUER_JWK",
      "FIA_CREDENTIAL_KEY_BASE64"
    ]
  },
  "r2_buckets": [
    {
      "binding": "FID_OBJECTS",
      "bucket_name": "fibre-presentation-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "FID_STATE",
        "class_name": "FibreIdentityAuthorityDurableObject"
      }
    ]
  },
  "workflows": [
    {
      "name": "fibre-asset-generation",
      "binding": "ASSET_GENERATION",
      "class_name": "AssetGenerationWorkflow",
      "script_name": "fibre-asset-generator"
    }
  ],
  "services": [
    {
      "binding": "WORLD_KERNEL",
      "service": "fibre-world-kernel"
    },
    {
      "binding": "THREAD_PRESENTATION",
      "service": "fibre-thread-presentation"
    }
  ],
  "exports": {
    "FibreIdentityAuthorityDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
