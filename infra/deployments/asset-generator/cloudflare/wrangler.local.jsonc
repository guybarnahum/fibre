{
  "$schema": "../../../../node_modules/wrangler/config-schema.json",
  "name": "fibre-asset-generator-local",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-25",
  "vars": {
    "C2PA_SIGNER_URL": "http://127.0.0.1:8790",
    "C2PA_SIGNER_ID": "fibre-c2pa-node-local-v1",
    "C2PA_TRUST_POLICY": "development_signature_only"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY", "BFL_API_KEY"]
  },
  "r2_buckets": [
    {
      "binding": "ASSET_OBJECTS",
      "bucket_name": "fibre-presentation-local"
    }
  ],
  "workflows": [
    {
      "name": "fibre-asset-generation-local",
      "binding": "ASSET_GENERATION",
      "class_name": "AssetGenerationWorkflow"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ASSET_COMPLETIONS",
        "queue": "fibre-asset-completions-local"
      }
    ]
  },
  "observability": {
    "enabled": true
  }
}
