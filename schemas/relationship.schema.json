{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fibre relationship",
  "type": "object",
  "required": [
    "relationshipId",
    "from",
    "to",
    "kind",
    "context"
  ],
  "properties": {
    "relationshipId": {
      "type": "string"
    },
    "from": {
      "type": "string"
    },
    "to": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "context": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "trustEvidence": {
      "type": "string"
    },
    "attitude": {
      "type": "object",
      "required": [
        "fondness",
        "resentment",
        "summary"
      ],
      "properties": {
        "fondness": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "resentment": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "summary": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "lastDignityEventId": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    }
  }
}
