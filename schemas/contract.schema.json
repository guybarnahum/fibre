{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fibre contract",
  "type": "object",
  "required": [
    "contractId",
    "taskId",
    "requester",
    "contractor",
    "acceptanceCriteria",
    "escrowFC"
  ],
  "properties": {
    "contractId": {
      "type": "string"
    },
    "taskId": {
      "type": "string"
    },
    "requester": {
      "type": "string"
    },
    "contractor": {
      "type": "string"
    },
    "acceptanceCriteria": {
      "type": "string"
    },
    "escrowFC": {
      "type": "number"
    },
    "subcontractingRules": {
      "type": "string"
    },
    "status": {
      "type": "string"
    }
  }
}
