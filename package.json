{
  "name": "fibre",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent world for artificial persons called Threads",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node tools/test-infra/run-test-suite.mjs active",
    "test:repro": "npm run build && node tools/test-infra/run-test-suite.mjs repro",
    "test:all": "npm run build && node tools/test-infra/run-test-suite.mjs all",
    "test:audit": "node tools/test-infra/test-value-audit.mjs",
    "validate": "node tools/repo/validate-repo.mjs && node --disable-warning=ExperimentalWarning tools/repo/validate-world-seed.mjs",
    "includes:sync": "node tools/repo/sync-markdown-includes.mjs --check",
    "includes:check": "node tools/repo/sync-markdown-includes.mjs --check",
    "context-pack": "node tools/repo/build-context-pack.mjs",
    "check": "npm run includes:check && npm test && npm run context-pack && node tools/repo/validate-repo.mjs --generated",
    "git-check": "node tools/repo/check-git-sync.mjs",
    "ready": "npm run git-check && npm run check",
    "editor": "node tools/editor/serve-thread-editor.mjs",
    "world-kernel": "node --disable-warning=ExperimentalWarning services/world-kernel/src/server.mjs",
    "birth-center": "node --disable-warning=ExperimentalWarning services/birth-center/src/server.mjs",
    "demo:m1": "node --disable-warning=ExperimentalWarning tools/repro/m1/m1-reviewed-proof.mjs",
    "demo:m1:editor": "node --disable-warning=ExperimentalWarning tools/repro/m1/m1-demo-editor.mjs",
    "model:smoke": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/model/model-api-smoke.mjs",
    "genesis:pass-a-dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-pass-a-dev.mjs",
    "genesis:rich-life-dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-rich-life-dev.mjs",
    "genesis:world-familiarity": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-world-familiarity-probe.mjs",
    "genesis:g2-genome-ceiling": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-cohort-genome-ceiling.mjs",
    "genesis:g2-lexical-overlap": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-g2-lexical-overlap.mjs",
    "genesis:g3-verify": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-g3-treatment-freeze.mjs",
    "genesis:g4-verify": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-g4-cognition-freeze.mjs",
    "genesis:g4-v3-verify": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-g4-v3-reliability-verify.mjs",
    "genesis:g4-v3-calibrate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-g4-v3-calibration-runner.mjs",
    "genesis:g34-amendments-verify": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-g34-review-amendments.mjs",
    "genesis:g5-verify": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-g5-diagnostics-freeze.mjs",
    "genesis:g6-verify": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-g6-verdict-freeze.mjs",
    "genesis:h-generate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-h-final-cohort.mjs",
    "genesis:h2-generate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-h2-final-cohort.mjs",
    "genesis:h2-recovery": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-h2-recovery.mjs",
    "genesis:replacement-gate-g2-closure": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-replacement-gate-g2-closure-verify.mjs --verify",
    "genesis:replacement-preflight": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-replacement-final-cohort.mjs --preflight",
    "genesis:replacement-generate": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-replacement-final-cohort.mjs",
    "genesis:replacement-recovery-preflight": "node --disable-warning=ExperimentalWarning tools/genesis/genesis-replacement-mechanical-recovery-preflight.mjs --preflight",
    "guardian:dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/guardian/semantic-guardian-dev-cli.mjs",
    "guardian:dev:counterfactual": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/guardian/semantic-guardian-v4-counterfactual-dev.mjs",
    "guardian:whole-person": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/guardian/whole-person-benchmark-v4.mjs",
    "guardian:gate": "node --disable-warning=ExperimentalWarning tools/gates/guardian/semantic-guardian-sealed-inspector.mjs",
    "guardian:gate:v4": "node --disable-warning=ExperimentalWarning tools/gates/guardian/semantic-guardian-sealed-inspector.mjs",
    "history:dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/history/history-bends-judgment-dev-cli.mjs",
    "history:gate": "node --disable-warning=ExperimentalWarning tools/gates/history/history-bends-judgment-sealed-inspector.mjs",
    "inspect:db": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-world-database.mjs",
    "inspect:obligations": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-structured-obligations.mjs",
    "inspect:identity": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-thread-identity.mjs",
    "inspect:genesis": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-genesis.mjs",
    "inspect:genome": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-symbolic-genome.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
