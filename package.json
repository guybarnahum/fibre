{
  "name": "fibre",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent world for artificial persons called Threads",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --test packages/domain/test/*.test.mjs",
    "validate": "node tools/validate-repo.mjs",
    "context-pack": "node tools/build-context-pack.mjs",
    "check": "npm test && npm run validate && npm run context-pack",
    "git-check": "node tools/check-git-sync.mjs",
    "ready": "npm run git-check && npm run check",
    "editor": "node tools/serve-thread-editor.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
