{
  "name": "fibre",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent world for artificial persons called Threads",
  "type": "module",
  "exports": {
    "./world-kernel/genesis-development-contracts": "./services/world-kernel/public/genesis-development-contracts.mjs",
    "./world-kernel/genesis-publication-contracts": "./services/world-kernel/public/genesis-publication-contracts.mjs"
  },
  "imports": {
    "#services/*": "./services/*",
    "#integrations/*": "./integrations/*",
    "#apps/*": "./apps/*",
    "#core/*": "./core/*",
    "#infra": "./infra/infra-driver.mjs",
    "#infra/scheduler": "./infra/scheduler.mjs",
    "#infra/service": "./infra/service.mjs",
    "#infra/providers/local": "./infra/providers/local/driver.mjs",
    "#infra/providers/local/service": "./infra/providers/local/service.mjs",
    "#infra/providers/local/scheduler": "./infra/providers/local/scheduler.mjs",
    "#infra/providers/local/sqlite-state": "./infra/providers/local/sqlite-state.mjs",
    "#infra/providers/cloudflare": "./infra/providers/cloudflare/index.mjs",
    "#infra/providers/cloudflare/queue": "./infra/providers/cloudflare/queue.mjs",
    "#infra/providers/cloudflare/scheduler": "./infra/providers/cloudflare/scheduler.mjs",
    "#infra/providers/cloudflare/presentation-channel-do": "./infra/providers/cloudflare/presentation-channel-do.mjs",
    "#fixtures/*": "./fixtures/*",
    "#tools/*": "./tools/*",
    "#repo-root": "./tools/shared/repo-root.mjs"
  },
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node tools/test-infra/run-test-suite.mjs active",
    "test:replay": "npm run build && node tools/test-infra/run-test-suite.mjs replay",
    "test:all": "npm run build && node tools/test-infra/run-test-suite.mjs all",
    "test:asset-live": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/presentation/asset-generation-live-smoke.mjs",
    "test:asset-live:cloudflare": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/presentation/asset-generation-live-cloudflare.mjs",
    "dev:asset-generator:cloudflare": "npx wrangler@latest dev --config infra/deployments/asset-generator/cloudflare/wrangler.local.jsonc --env-file .env",
    "dev:asset-stack:cloudflare": "npx wrangler@latest dev --config infra/deployments/thread-presentation/cloudflare/wrangler.local.jsonc --config infra/deployments/asset-generator/cloudflare/wrangler.local.jsonc --env-file .env --port 8788",
    "deploy:asset-generator:cloudflare:dry": "npx wrangler@latest deploy --dry-run --config infra/deployments/asset-generator/cloudflare/wrangler.jsonc",
    "deploy:asset-generator:cloudflare": "npx wrangler@latest deploy --config infra/deployments/asset-generator/cloudflare/wrangler.jsonc",
    "deploy:thread-presentation:cloudflare:dry": "npx wrangler@latest deploy --dry-run --config infra/deployments/thread-presentation/cloudflare/wrangler.jsonc",
    "deploy:thread-presentation:cloudflare": "npx wrangler@latest deploy --config infra/deployments/thread-presentation/cloudflare/wrangler.jsonc",
    "deploy:world-kernel:cloudflare:dry": "npx wrangler@latest deploy --dry-run --config infra/deployments/world-kernel/cloudflare/wrangler.jsonc",
    "deploy:world-kernel:cloudflare": "npx wrangler@latest deploy --config infra/deployments/world-kernel/cloudflare/wrangler.jsonc",
    "deploy:birth-center:cloudflare:dry": "npx wrangler@latest deploy --dry-run --config infra/deployments/birth-center/cloudflare/wrangler.jsonc",
    "deploy:birth-center:cloudflare": "npx wrangler@latest deploy --config infra/deployments/birth-center/cloudflare/wrangler.jsonc",
    "cloud:provision": "node tools/deployment/provision-cloudflare.mjs",
    "cloud:configure-secrets": "node tools/deployment/configure-cloudflare-secrets.mjs",
    "cloud:deploy": "node tools/deployment/deploy-cloudflare.mjs",
    "test:audit": "node tools/test-infra/test-value-audit.mjs",
    "deployment:validate": "node tools/deployment/validate-deployment-manifest.mjs",
    "deployment:validate:remote": "node tools/deployment/validate-deployment-manifest.mjs infra/deployments/environments/cloudflare.yaml",
    "validate": "node tools/repository/validate-repo.mjs && node --disable-warning=ExperimentalWarning tools/repository/validate-world-seed.mjs && node tools/deployment/validate-deployment-manifest.mjs && node tools/deployment/validate-deployment-manifest.mjs infra/deployments/environments/cloudflare.yaml",
    "includes:sync": "node tools/repository/sync-markdown-includes.mjs",
    "includes:check": "node tools/repository/sync-markdown-includes.mjs --check",
    "context-pack": "node tools/repository/build-context-pack.mjs",
    "check": "npm run includes:check && npm test && npm run context-pack && node tools/repository/validate-repo.mjs --generated",
    "git-check": "node tools/repository/check-git-sync.mjs",
    "ready": "npm run git-check && npm run check",
    "editor": "node tools/editor/serve-thread-editor.mjs",
    "world-kernel": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning infra/deployments/world-kernel/local/visual-server.mjs",
    "birth-center": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning infra/deployments/birth-center/local/server.mjs",
    "content-credential-signer": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning infra/deployments/content-credential-signer/local/server.mjs",
    "genesis:d5-sealed-history": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis/genesis-d5-sealed-history-diagnostic.mjs",
    "demo:m1": "node --disable-warning=ExperimentalWarning tools/replays/m1/m1-reviewed-proof.mjs",
    "demo:m1:editor": "node --disable-warning=ExperimentalWarning tools/replays/m1/m1-demo-editor.mjs",
    "model:smoke": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/model/model-api-smoke.mjs",
    "guardian:dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/guardian/semantic-guardian-dev-cli.mjs",
    "guardian:dev:counterfactual": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/guardian/semantic-guardian-v4-counterfactual-dev.mjs",
    "guardian:whole-person": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/guardian/whole-person-benchmark-v4.mjs",
    "guardian:gate": "node --disable-warning=ExperimentalWarning tools/gates/guardian/semantic-guardian-sealed-inspector.mjs",
    "guardian:gate:v4": "node --disable-warning=ExperimentalWarning tools/gates/guardian/semantic-guardian-sealed-inspector.mjs",
    "history:dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/history/history-bends-judgment-dev-cli.mjs",
    "history:gate": "node --disable-warning=ExperimentalWarning tools/gates/history/history-bends-judgment-sealed-inspector.mjs",
    "identity-context:causal-live": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/gates/identity-context/identity-context-causal-differential-live.mjs",
    "identity-context:hostile-closeout": "node --disable-warning=ExperimentalWarning tools/gates/identity-context/identity-context-hostile-closeout.mjs",
    "inspect:db": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-world-database.mjs",
    "inspect:obligations": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-structured-obligations.mjs",
    "inspect:identity": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-thread-identity.mjs",
    "inspect:genesis": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-genesis.mjs",
    "inspect:genome": "node --disable-warning=ExperimentalWarning tools/inspect/inspect-symbolic-genome.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
