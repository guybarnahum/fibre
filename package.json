{
  "name": "fibre",
  "version": "0.1.0",
  "private": true,
  "description": "Persistent world for artificial persons called Threads",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "test": "npm run build && node --disable-warning=ExperimentalWarning --test packages/domain/test/*.test.mjs services/world-kernel/test/*.test.mjs tools/*.test.mjs",
    "validate": "node tools/validate-repo.mjs && node --disable-warning=ExperimentalWarning tools/validate-world-seed.mjs",
    "includes:sync": "node tools/sync-markdown-includes.mjs",
    "includes:check": "node tools/sync-markdown-includes.mjs --check",
    "context-pack": "node tools/build-context-pack.mjs",
    "check": "npm run includes:check && npm test && npm run context-pack && node tools/validate-repo.mjs --generated",
    "git-check": "node tools/check-git-sync.mjs",
    "ready": "npm run git-check && npm run check",
    "editor": "node tools/serve-thread-editor.mjs",
    "world-kernel": "node --disable-warning=ExperimentalWarning services/world-kernel/src/server.mjs",
    "demo:m1": "node --disable-warning=ExperimentalWarning tools/m1-reviewed-proof.mjs",
    "demo:m1:editor": "node --disable-warning=ExperimentalWarning tools/m1-demo-editor.mjs",
    "model:smoke": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/model-api-smoke.mjs",
    "genesis:genome-control": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-genome-control-cli.mjs",
    "genesis:pass-a-dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-pass-a-dev.mjs",
    "genesis:rich-life-dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-rich-life-dev.mjs",
    "genesis:e2-h6-probe": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-rich-life-e2-h6-probe.mjs",
    "genesis:e2-a0": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-rich-life-e2-a0-candidate-driver.mjs",
    "genesis:e2-h6-participation": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-rich-life-e2-h6-participation.mjs",
    "genesis:e2-a2": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-rich-life-e2-a2.mjs",
    "genesis:e2-a2b": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-rich-life-e2-a2b-driver.mjs",
    "genesis:e2-n1": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/genesis-rich-life-e2-n1-repair-driver.mjs",
    "guardian:dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/semantic-guardian-dev-cli.mjs",
    "guardian:dev:counterfactual": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/semantic-guardian-v4-counterfactual-dev.mjs",
    "guardian:whole-person": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/whole-person-benchmark-v4.mjs",
    "guardian:gate": "node --disable-warning=ExperimentalWarning tools/semantic-guardian-sealed-inspector.mjs",
    "guardian:gate:v4": "node --disable-warning=ExperimentalWarning tools/semantic-guardian-sealed-inspector.mjs",
    "history:dev": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning tools/history-bends-judgment-dev-cli.mjs",
    "history:gate": "node --disable-warning=ExperimentalWarning tools/history-bends-judgment-sealed-inspector.mjs",
    "inspect:db": "node --disable-warning=ExperimentalWarning tools/inspect-world-database.mjs",
    "inspect:obligations": "node --disable-warning=ExperimentalWarning tools/inspect-structured-obligations.mjs",
    "inspect:identity": "node --disable-warning=ExperimentalWarning tools/inspect-thread-identity.mjs",
    "inspect:genesis": "node --disable-warning=ExperimentalWarning tools/inspect-genesis.mjs",
    "inspect:genome": "node --disable-warning=ExperimentalWarning tools/inspect-symbolic-genome.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
