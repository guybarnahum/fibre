# Fibre local/operator environment example
# Copy or generate an operator-controlled secrets/config file and replace placeholders.
# Never commit real credentials.
#
# Cloud secret configuration does NOT read .env implicitly. Pass the chosen file explicitly,
# for example: npm run cloud:configure-secrets -- --file .env --env staging

# Image/model provider secrets
OPENAI_API_KEY=<sk-...-your-openai-api-key>
BFL_API_KEY=<bfl_...-your-bfl-api-key>
GEMINI_API_KEY=<your-gemini-api-key>

# Fibre service authentication secrets
# Service-to-service private authentication. Generate a strong random value.
FIBRE_PRIVATE_TOKEN=<random-private-service-token>

# Human/operator administrative authentication. Keep distinct from FIBRE_PRIVATE_TOKEN.
FIBRE_ADMIN_TOKEN=<random-admin-token>

# Production C2PA signer
# URL/ID/trust policy are configuration; token is secret.
C2PA_SIGNER_URL=<https://production-c2pa-signer.example>
C2PA_SIGNER_TOKEN=<production-c2pa-signer-auth-token>
C2PA_SIGNER_ID=fibre-c2pa-production-v1
C2PA_TRUST_POLICY=c2pa_trust_list

# Public Viewer configuration
VIEWER_ORIGIN=https://insidefibre.com

# Cloudflare deployment/operator credentials
# Used by Wrangler/CI to provision/deploy infrastructure; do not expose to Fibre Workers
# unless a concrete runtime requirement exists.
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_API_TOKEN=<cloudflare-deployment-api-token>

# Local/hybrid service endpoints when running Node services against remote deployments.
# Fully-cloud Cloudflare composition should prefer provider/service bindings for private services.
FIBRE_ASSET_GENERATOR_URL=<asset-generator-url>
FIBRE_THREAD_PRESENTATION_URL=https://api.insidefibre.com
FIBRE_WORLD_KERNEL_URL=<world-kernel-url>
