# Fibre local/operator environment example
# Copy to .env, replace only the values required for the workflow you are running,
# and never commit real credentials.
#
# cloud:provision, cloud:configure-secrets, cloud:deploy, and genesis:e2e:staging
# load .env for operator/runtime values.
# cloud:configure-secrets still requires the explicit source file whose Worker secrets/config
# should be uploaded, for example:
#   npm run cloud:configure-secrets -- --file .env --env staging
# cloud:deploy:apps also reads this file explicitly:
#   npm run cloud:deploy:apps -- --file .env --env staging

# -----------------------------------------------------------------------------
# REQUIRED — Slice G fully-cloud staging E2E and operator surfaces
# -----------------------------------------------------------------------------

# Genesis reasoning and default non-reference image generation.
OPENAI_API_KEY=<sk-...-your-openai-api-key>

# Reference-conditioned image generation.
BFL_API_KEY=<bfl_...-your-bfl-api-key>

# Fibre service-to-service authentication used by deployed Workers and E2E inspection.
# Generate a strong random value and keep it distinct from any human/admin credential.
FIBRE_PRIVATE_TOKEN=<random-private-service-token>

# Cloudflare operator credentials used by Wrangler to provision and deploy staging resources.
# For cloud:deploy:apps, the token must also be able to read the Zero Trust organization
# and Access applications/policies so Fibre can discover the Access issuer/audience:
#   Access: Organizations, Identity Providers, and Groups Read
#   Access: Apps and Policies Read
# These are operator-only credentials and must not be exposed to Fibre Workers unless a
# concrete runtime requirement is introduced.
CLOUDFLARE_ACCOUNT_ID=<cloudflare-account-id>
CLOUDFLARE_API_TOKEN=<cloudflare-deployment-api-token>

# Fibre Admin authorization is not configured here. Cloudflare Access authenticates the
# human; the shared ACTIVITY_LOG D1 database contains fibre_admin_entitlements and is the
# final Admin authorization gate. Grant/revoke rows directly in D1 operator tooling.

# -----------------------------------------------------------------------------
# OPTIONAL — Admin infrastructure monitor
# -----------------------------------------------------------------------------

# Dedicated read-only token used only by the Admin resource-health monitor. Give this token
# Cloudflare Account Analytics Read access; do not reuse CLOUDFLARE_API_TOKEN here.
# Configure the Admin Worker secret after provisioning with:
#   node tools/ops/configure-admin-infra-monitor.mjs --env staging --file .env
# FIBRE_CLOUDFLARE_ANALYTICS_TOKEN=<cloudflare-read-only-analytics-token>

# The server caches one global sample for this many seconds. Force sample in Admin bypasses
# freshness while still using a short sampling lease to prevent concurrent sampling storms.
# FIBRE_INFRA_SAMPLE_TTL_SECONDS=900

# Critical thresholds. Admin shows Elevated at >= 50% and Critical at >= 100%.
# FIBRE_INFRA_D1_ROWS_READ_DAILY_WARN=500000
# FIBRE_INFRA_D1_ROWS_WRITTEN_DAILY_WARN=10000
# FIBRE_INFRA_WORKER_REQUESTS_15M_WARN=25000
# FIBRE_INFRA_WORKER_ERRORS_15M_WARN=100

# -----------------------------------------------------------------------------
# OPTIONAL — other local/development workflows
# -----------------------------------------------------------------------------

# Gemini is not used by the current Slice G Cloudflare deployment.
# Set only for workflows that explicitly select Gemini.
# GEMINI_API_KEY=<your-gemini-api-key>

# Human/operator administrative authentication. Not required for Slice G cloud E2E.
# Keep distinct from FIBRE_PRIVATE_TOKEN.
# FIBRE_ADMIN_TOKEN=<random-admin-token>

# -----------------------------------------------------------------------------
# REQUIRED — Fibre Identity Authority
# -----------------------------------------------------------------------------

# FIA card finalization uses Fibre's Cloudflare-hosted C2PA signer.
# Encode the PEM certificate chain and private key as one-line base64 values.
# Certificate/key material is uploaded only to fibre-content-credential-signer.
C2PA_SIGNER_TOKEN=<random-fibre-c2pa-service-token>
C2PA_SIGNER_CERT_BASE64=<base64-encoded-pem-certificate-chain>
C2PA_SIGNER_KEY_BASE64=<base64-encoded-pem-private-key>

# FIA signs each machine credential with an Ed25519 private JWK.
# Keep the JWK on one line in .env; it is uploaded only to the FIA Worker.
FIA_ISSUER_JWK=<single-line-ed25519-private-jwk-json>

# 32 random bytes, base64 encoded. Used only to protect FIA machine credentials.
# This is uploaded only to the FIA Worker.
FIA_CREDENTIAL_KEY_BASE64=<base64-encoded-32-byte-key>

# -----------------------------------------------------------------------------
# OPTIONAL — Viewer origin override
# -----------------------------------------------------------------------------

# Do NOT set VIEWER_ORIGIN for the standard staging deployment.
# The deployment resolver maps the production default automatically:
#   https://insidefibre.com -> https://staging.insidefibre.com
# Set this only when intentionally overriding the declared Viewer origin for a custom deployment.
# VIEWER_ORIGIN=https://insidefibre.com

# -----------------------------------------------------------------------------
# OPTIONAL — local/hybrid service endpoints
# -----------------------------------------------------------------------------

# Not used by the fully-cloud Slice G staging E2E. The staging runner discovers deployed
# Birth Center, World, Fibre Identity Authority, Thread Presentation, and Viewer endpoints from the SHA-bound
# .fibre/cloudflare/staging/deployment.json record instead.
# FIBRE_ASSET_GENERATOR_URL=<asset-generator-url>
# FIBRE_THREAD_PRESENTATION_URL=https://api.insidefibre.com
# FIBRE_WORLD_KERNEL_URL=<world-kernel-url>