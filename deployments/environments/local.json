{
  "deploymentVersion": "fibre-deployment-v0.1",
  "environment": "local",
  "providers": {
    "cloudflare-local": {
      "platform": "cloudflare",
      "infraDriver": "cloudflare-v1",
      "capabilities": [
        "streams",
        "objects",
        "catalog",
        "realtime",
        "queues",
        "workflows"
      ]
    }
  },
  "services": {
    "thread-presentation": {
      "runtime": "cloudflare-local",
      "infra": "cloudflare-local",
      "requires": [
        "streams",
        "objects",
        "catalog",
        "realtime",
        "queues",
        "workflows"
      ]
    },
    "asset-generator": {
      "runtime": "cloudflare-local",
      "infra": "cloudflare-local",
      "requires": [
        "objects",
        "queues",
        "workflows"
      ]
    }
  }
}
