{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  "name": "fibre-presentation-local",
  "main": "./worker.mjs",
  "compatibility_date": "2026-08-21",
  "vars": {
    "VIEWER_ORIGIN": "http://localhost:5173",
    "P3_FIXTURE_MODE": "1",
    "C2PA_SIGNER_URL": "http://127.0.0.1:8790"
  },
  "r2_buckets": [
    {
      "binding": "PRESENTATION_OBJECTS",
      "bucket_name": "fibre-presentation-local"
    }
  ],
  "d1_databases": [
    {
      "binding": "PRESENTATION_CATALOG",
      "database_name": "fibre-presentation-local",
      "database_id": "00000000-0000-0000-0000-000000000001",
      "preview_database_id": "fibre-presentation-local"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "PRESENTATION_CHANNELS",
        "class_name": "FibrePresentationChannelDurableObject"
      }
    ]
  },
  "workflows": [
    {
      "name": "fibre-asset-generation-local",
      "binding": "ASSET_GENERATION",
      "class_name": "AssetGenerationWorkflow",
      "script_name": "fibre-asset-generator-local"
    }
  ],
  "queues": {
    "consumers": [
      {
        "queue": "fibre-asset-completions-local",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 10,
        "dead_letter_queue": "fibre-asset-completions-local-dlq"
      }
    ]
  },
  "exports": {
    "FibrePresentationChannelDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true
  }
}
